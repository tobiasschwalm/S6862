{
  "name": "S6862 – Spec-Driven Development mit OpenSpec",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "ANTHROPIC_MODEL": "sonnet"
  },
  "remoteEnv": {
    // API-Schlüssel aus der Umgebungsvariablen des eigenen Rechners (Windows, macOS, Linux), Anleitung in der README.
    // Ist sie dort nicht gesetzt, bleibt der Wert leer und Claude Code verlangt die Anmeldung.
    // Nach einer Änderung VS Code ganz neu starten, danach reicht "Reload Window", kein Rebuild.
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "anthropic.claude-code",
        "redhat.vscode-yaml",
        "ms-python.python",
        "ms-vscode.live-server",
        "mathematic.vscode-pdf"
      ]
    }
  },
  "postCreateCommand": "mkdir -p projekte && echo \"OpenSpec $(openspec --version), Node.js $(node --version), Claude Code $(claude --version), $(java -version 2>&1 | head -1), OpenFastTrace $(basename $OFT_JAR)\" && echo 'Lernumgebung bereit. Aufgaben in aufgaben/, Vorlagen in vorlagen/, eigene Projektordner unter projekte/.'"
}
